# Gradle / 构建产物
.gradle/
build/
*.apk
*.aab
*.ap_
*.dex

# 本机配置（含 SDK 路径，不应提交）
local.properties
env-check.txt

# IDE
*.iml
.idea/
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# Kotlin 2.x 编译器会话目录
.kotlin/

# 本机工作记录（含调试日志与个人数据）
.workbuddy/

# 本机调试产物
.tmp/

# 构建日志与临时文件
*.log
tmp_build.log
tmp_test.log

# 签名文件（只在发布机上存在）
keystore.properties
keystore/
*.jks
*.keystore

# 例外：CI 用的公开自签名密钥，必须进仓库才能保证每次构建签名一致
!ci/classflow-ci.jks
