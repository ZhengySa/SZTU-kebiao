<?xml version="1.0" encoding="utf-8"?>
<!--
  深色模式下的内部小卡：半透明深蓝紫玻璃。
  沿用浅色版的"更亮一层"思路，但底色压暗，避免在深色壁纸上发灰。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:centerColor="#403A4E96"
                android:endColor="#2E30437A"
                android:startColor="#52405AAE"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#4C8FA4FF" />
        </shape>
    </item>
</layer-list>
