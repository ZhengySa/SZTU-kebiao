<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限清单刻意很小，这也是隐私承诺的一部分：
      · INTERNET + ACCESS_NETWORK_STATE  仅用于「登录学校教务系统并拉取课表」，
        域名白名单：jwxt.sztu.edu.cn / auth.sztu.edu.cn，代码里写死，没有别的出网路径
      · POST_NOTIFICATIONS  Android 13+ 发课前提醒
      · SCHEDULE_EXACT_ALARM 精确到分钟的课前提醒（用户可在系统设置里拒绝，App 会自动降级）
      · RECEIVE_BOOT_COMPLETED 重启后把小组件刷新与提醒重新排上
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ClassFlowApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.ClassFlow">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ClassFlow"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 今日课表小组件（4x2 / 2x4 / 4x4 自适应） -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- 午夜闹钟到点：把小组件刷成新的一天，并排上明天的闹钟 -->
        <receiver
            android:name=".widget.WidgetDayTickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.classflow.timetable.action.WIDGET_DAY_TICK" />
            </intent-filter>
        </receiver>

        <!-- 课前提醒闹钟到点 -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <!-- 开机 / 改时间 / 改时区 / 跨天 / 应用升级 后恢复排程 -->
        <receiver
            android:name=".widget.SystemEventReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
